# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
# NextAuth v5 reads AUTH_SECRET; NEXTAUTH_SECRET is kept as fallback
AUTH_SECRET=
NEXTAUTH_SECRET=

# Set to your Vercel domain in production, e.g. https://pmail.vercel.app
NEXTAUTH_URL=http://localhost:3001

# ─── OAuth Providers ──────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
# Enable Gmail API: console.cloud.google.com/apis/library/gmail.googleapis.com
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure Portal → App registrations
# Redirect URI: https://<your-domain>/api/auth/callback/microsoft-entra-id
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API
# Client-side (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only — bypasses RLS, never expose to the browser
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── IMAP password encryption ─────────────────────────────────────────────────
# Generate: openssl rand -base64 32
ENCRYPTION_SECRET=

# ─── Web Push (PWA notifications) ─────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
