# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
# NextAuth v5 reads AUTH_SECRET; NEXTAUTH_SECRET is kept as fallback
AUTH_SECRET=
NEXTAUTH_SECRET=

# Set to your Vercel domain in production, e.g. https://aire.vercel.app
NEXTAUTH_URL=http://localhost:3001

# ─── OAuth Providers ──────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
# Enable Gmail API: console.cloud.google.com/apis/library/gmail.googleapis.com
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure Portal → App registrations
# Redirect URI: https://<your-domain>/api/auth/callback/microsoft-entra-id
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Recommended: Neon (neon.tech) — free tier, serverless PostgreSQL
#
# From your Neon project → Connection Details:
#   DATABASE_URL  = Pooled connection string (Pooler tab)  ← Prisma Client
#   DIRECT_URL    = Direct connection string (Direct tab)  ← prisma migrate
#
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ─── IMAP password encryption ─────────────────────────────────────────────────
# Generate: openssl rand -base64 32
ENCRYPTION_SECRET=

# ─── Web Push (PWA notifications) ─────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
