# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
# NextAuth v5 reads AUTH_SECRET; NEXTAUTH_SECRET is kept as fallback
AUTH_SECRET=
NEXTAUTH_SECRET=

# Set to your Vercel domain in production, e.g. https://aire.vercel.app
NEXTAUTH_URL=http://localhost:3001

# ─── OAuth Providers ──────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
# Enable Gmail API: console.cloud.google.com/apis/library/gmail.googleapis.com
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure Portal → App registrations
# Redirect URI: https://<your-domain>/api/auth/callback/microsoft-entra-id
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Supabase project → Settings → Database → Connection string
#
#   DATABASE_URL  = Transaction pooler  (port 6543)  ← Prisma Client (serverless)
#   DIRECT_URL    = Direct connection   (port 5432)  ← prisma migrate
#
# DATABASE_URL format (Transaction Pooler):
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# DIRECT_URL format:
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ─── IMAP password encryption ─────────────────────────────────────────────────
# Generate: openssl rand -base64 32
ENCRYPTION_SECRET=

# ─── Web Push (PWA notifications) ─────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
