{
  "name": "pmail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "prepare": "husky",
    "dev": "next dev",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ai": "vitest run tests/ai/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "worker": "tsx worker.ts",
    "agent": "tsx scripts/agent.ts",
    "spec": "tsx scripts/agent.ts spec-agent",
    "implement": "tsx scripts/agent.ts code-agent",
    "review": "tsx scripts/agent.ts review-agent",
    "test-feature": "tsx scripts/agent.ts test-agent",
    "ship": "tsx scripts/agent.ts sync-agent"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@auth/prisma-adapter": "^2.8.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@prisma/client": "^6.0.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.13.0",
    "@tiptap/extension-link": "^2.10.0",
    "@tiptap/extension-placeholder": "^2.10.0",
    "@tiptap/react": "^2.10.0",
    "@tiptap/starter-kit": "^2.10.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.34.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.2.1",
    "dompurify": "^3.2.3",
    "imap": "^0.8.19",
    "jsdom": "^26.0.0",
    "lucide-react": "^1.16.0",
    "mailparser": "^3.7.2",
    "next": "^14.2.35",
    "next-auth": "^5.0.0-beta.29",
    "nodemailer": "^8.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^2.2.7",
    "sharp": "^0.34.5",
    "swr": "^2.3.0",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.4.0",
    "@playwright/test": "^1.50.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/imap": "^0.8.43",
    "@types/jsdom": "^21.1.7",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-window": "^1.8.8",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "msw": "^2.7.0",
    "postcss": "^8.5.1",
    "prettier": "^3.8.3",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "nodemailer": "^8.0.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
